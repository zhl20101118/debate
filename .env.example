# 复制本文件为 .env 后填写；.env 已被 .gitignore 忽略，不会进入仓库。
# 也可以完全不建 .env，直接在网页「设置 → 模型」里填 API Key（存到 data/secrets.json，同样不入库）。

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：更稳的搜索后端（不填则用内置 Bing / DuckDuckGo / 维基百科 抓取）
TAVILY_API_KEY=
SERPER_API_KEY=

# 服务端口与监听地址（0.0.0.0 让同一局域网内的手机/平板也能看直播）
PORT=8787
HOST=0.0.0.0

# 管理口令：留空则任何人都能控制辩论进度；填了后控制类操作需带上它
ADMIN_TOKEN=
